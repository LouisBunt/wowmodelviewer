  <table name="ItemSparse">
    <!-- SPARSE table: every field sits inline, one after the next, strings included, so a
         field can only be located by walking everything in front of it. That is why all 67
         record fields are declared here even though four are wanted: store="no" means the
         reader steps over the field but creates no column (see FieldStructure::store).
         Order and widths follow ItemSparse.dbd, LAYOUT 1C17D17F (the 12.0.7 layout). If a
         patch changes that layout, this block has to follow it or every value behind the
         first wrong entry shifts. -->
    <field type="int32" name="ID" primary="yes" />
    <field type="text" name="Description_lang" pos="0" />
    <field type="text" name="Display3_Lang" pos="1" />
    <field type="text" name="Display2_Lang" pos="2" />
    <field type="text" name="Display1_Lang" pos="3" />
    <field type="text" name="Display_Lang" pos="4" />
    <field type="int32" name="ExpansionID" pos="5" />
