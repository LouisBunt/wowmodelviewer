  </table>
  <table name="ChrCustomizationReq">
    <!-- ID is noninline (id-list), so record fields start at index 0. Positions are
         the 12.0.7 layout CA154412 (build 68235): ClassMask is field index 3 -> pos 2,
         and RaceMask is the RaceMasks<32>[2] field at DBD index 9 -> pos 8 (read as a
         64-bit mask). The old 12.0.5 (216BEF26) positions (RaceMask=0, ClassMask=3) read
         a string offset as RaceMask -> garbage race-gating -> wrong customization choices. -->
    <field type="int32" name="ID" primary="yes" />
    <field type="int64" name="RaceMask" pos="8" />
    <field type="int32" name="ClassMask" pos="2" />
    <!-- Unlock gates (CA154412 record positions): a choice with any of these set is a
         conditional/collectible appearance the account must earn (achievement, quest, or
         a transmog item appearance). The in-game creator hides those by default, so we use
         them to drop "borrowed" entries instead of guessing from the race mask. -->
    <field type="int32" name="ReqAchievementID" pos="4" />
    <field type="int32" name="ReqQuestID" pos="5" />
    <field type="int32" name="ReqItemModifiedAppearanceID" pos="7" />
  </table>
