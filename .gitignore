syntax: glob
bin/*
CMakeBuild/*
Source/latex/*
Source/html/*
.project
.cproject
.settings/*
Installers/Windows/NSIS/*.exe
VisualStudio2013/*
build
.vs
.vscode

# local build helpers (machine-specific paths)
/_*.bat

# community listfile is large (>100MB) and fetched/updated out of band
bin_support/wow/listfile.csv

# installer build output (the compiled setup.exe is large and regenerated)
installer/dist

# x64 build tree (out-of-source, regenerated)
/build64

# x64 AddressSanitizer build tree (out-of-source, regenerated for debugging)
/build64-asan

# wxWidgets 3.x prebuilt x64 tree (~200MB, re-acquired from github v3.2.10 vc14x_x64 assets)
/ThirdParty/wxWidgets3

# aqt Qt-download log
aqtinstall.log

# Python bytecode (the bundled Blender add-on is tracked source)
__pycache__/
*.pyc

/ThirdParty/fbx_x64
/ThirdParty/ossl_build
/ThirdParty/openssl_x64

# out-of-source build trees for this fork (regenerated by cmake -B)
/build-x64
/build-diag
build-log*.txt
phase*-log.txt
